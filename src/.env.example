# LLM backend: ollama (free, local) or openai (paid)
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# To use OpenAI instead, uncomment these and set LLM_BACKEND=openai
# LLM_BACKEND=openai
# OPENAI_API_KEY=your-openai-api-key-here

# Embeddings: huggingface (free, local) or openai (paid)
EMBEDDING_BACKEND=huggingface
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# To use OpenAI embeddings instead, uncomment these
# EMBEDDING_BACKEND=openai

# Vector store
VECTOR_STORE=faiss

# Paths
DATA_DIR=data/sample_docs
VECTORSTORE_DIR=data/vectorstore

# Chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4